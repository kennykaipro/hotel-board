  "scoring": {
    "credibility": {
      "source_authority": 25,
      "completeness": 20,
      "cross_source": 20,
      "official_evidence": 20,
      "logic_consistency": 15,
      "threshold_push": 80,
      "threshold_weekly": 60
    },
    "lead_value": {
      "brand_tier": 20,
      "investment_scale": 20,
      "project_stage": 20,
      "region_value": 20,
      "decision_reachability": 20
    }
  },
  "dedup": {
    "primary_key": "detail_url",
    "secondary_keys": ["title", "publish_date"],
    "rule": "以详情 url 作为唯一 key；url 不变的页面叠加【标题+发布日期】二次去重",
    "id_same": "version + 1",
    "name_fingerprint_similarity": 0.92
  },
  "china_only": {
    "enabled": true,
    "regions": ["中国大陆", "港澳"],
    "rule": "AI 解析详情页时过滤非中国地区项目，只保留中国大陆（含港澳）酒店项目；被过滤的海外新闻在日志标记，不存入列表"
  },
  "media_extra_filter": {
    "enabled": true,
    "rule": "媒体文章只保留【新项目签约、落地、拟建、开业、物业合作】类资讯；人事变动、财报、行业点评、招聘全部过滤，不入库"
  }
