{
  "version": "2.0.0",
  "project": "hotel-board",
  "updated_at": "2026-11-19T00:00:00+08:00",
  "description": "全国酒店项目情报官 · 采集规则配置 v2（12 个预置数据源，独立于页面，更新本文件无需重新加密 index.html）",
  "admin": {
    "ai_auto_probe": true,
    "ai_probe_off_hint": "关闭后：选择器为空的站点不触发 AI 探测，直接跳过，不消耗积分",
    "max_pages_default": 5,
    "global_concurrency": 2,
    "default_interval_ms": [
      1200,
      2200
    ],
    "max_retries": 3,
    "request_timeout_sec": 15,
    "403_skip_after": 3,
    "403_cooldown_min": 1440,
    "js_dynamic_skip": true,
    "log_mark_skip": true
  },
  "run": {
    "schedule": "每日 23:30（Asia/Shanghai）",
    "concurrency": 2,
    "global_limit_per_run": 200,
    "domain_limit_per_run": 30,
    "request_interval_ms": [
      1200,
      2200
    ],
    "max_pages": 5,
    "max_retries": 3,
    "request_timeout_sec": 15,
    "user_agent": "HotelBoardBot/1.0 (+CONTACT_EMAIL)",
    "respect_robots_txt": true,
    "conditional_request": [
      "ETag",
      "Last-Modified"
    ],
    "retry_after_429": true,
    "circuit_breaker": {
      "consecutive_failures": 3,
      "domain_cooldown_min": 1440
    },
    "privacy": {
      "collect_personal_info": false,
      "keep_original_text": false,
      "keep_url_and_summary_only": true
    }
  },
  "time_filters": {
    "options": [
      "today",
      "1m",
      "3m",
      "6m"
    ],
    "default": "3m",
    "label": {
      "today": "当天",
      "1m": "1 个月",
      "3m": "3 个月",
      "6m": "半年"
    }
  },
  "pagination": {
    "enabled": true,
    "max_pages_default": 5,
    "max_pages_hint": "后台【最大翻页页数】默认 5 页，可在各数据源单独覆盖"
  },
  "time_break": {
    "enabled": true,
    "field": "publish_date",
    "rule": "当页面公告日期早于配置时间范围，立刻停止该站点翻页，减少无效请求"
  },
  "rate_limit": {
    "interval_ms": [
      1200,
      2200
    ],
    "global_concurrency": 2,
    "rule": "同一网站两次请求间隔 1200-2200ms，全局并发最多 2 个站点"
  },
  "error_policy": {
    "max_retries": 3,
    "retry_codes": [
      403,
      429
    ],
    "timeout_retry": true,
    "skip_site_on_fail": true,
    "skip_rule": "网络异常 403/429/超时最多重试 3 次，失败直接跳过该站点，采集任务不整体卡死",
    "403_auto_skip": {
      "enabled": true,
      "skip_after": 3,
      "cooldown_min": 1440,
      "log_mark": "⚠️ 403 多次返回，已标记并自动跳过，避免 IP 被封禁"
    }
  },
  "ai_probe": {
    "enabled": true,
    "rule": "手动填写完整 CSS 选择器则完全不调用 AI；只有全部选择器为空才触发 AI 探测，探测成功自动回填选择器保存，下次直接复用",
    "admin_switch": "admin.ai_auto_probe",
    "js_dynamic_page": {
      "enabled": true,
      "action": "检测到 JS 动态渲染页面后直接跳过，日志红色提示，不消耗积分"
    }
  },
  "link_processing": {
    "relative_to_absolute": true,
    "rule": "相对链接自动拼接域名生成完整绝对链接，修复 404 跳转"
  },
